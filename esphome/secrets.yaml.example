# Also encrypts native OTA uploads; there is no separate OTA password.
api_encryption_key: ENTER_ENCRYPTION_KEY
# Only the dev build's web server (or a web_server block you add to your own
# device YAML) uses these; the shipped firmware does not run one.
web_username: admin
web_password: secret
wifi_ssid: WIFI_SSID
wifi_password: WIFI_PWS
ap_password: AP_PWS

